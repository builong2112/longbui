# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.
ANTHROPIC_API_KEY=sk-ant-...
# Model AI đọc biểu mẫu (mặc định claude-opus-5-5). Có thể đổi claude-sonnet-5-5 / claude-haiku-5-5 để giảm chi phí.
CLAUDE_MODEL=claude-opus-5-5
# Mức suy luận: low | medium | high. medium là cân bằng tốt cho đọc biểu mẫu.
CLAUDE_EFFORT=medium
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập.
IPC_SECRET_KEY=doi-chuoi-nay
# Thư mục lưu database + file gốc (mặc định ./data)
# IPC_DATA_DIR=/srv/ipc-data
